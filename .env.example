# Configuracoes do LLM (Groq)
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.4

# Controle de Custos e Limites
MAX_CORRECOES_SISTEMA_DIA=50
MAX_CORRECOES_USUARIO_DIA=3

# Configuracoes ChromaDB (HuggingFace Local)
CHROMA_PATH=./chroma_db
COLLECTION_NAME=criterios_enem
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K=4
